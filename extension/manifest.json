{
  "manifest_version": 3,
  "name": "Lumiere - Watch Party Sync",
  "version": "1.1.0",
  "description": "Synchronize Netflix, Prime Video, JioHotstar, Zee5, and more with your Lumiere watch party room.",
  "author": "Ayushman Mitra",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Lumiere Watch Party"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://*.netflix.com/*",
    "https://netflix.com/*",
    "https://*.primevideo.com/*",
    "https://primevideo.com/*",
    "https://*.amazon.com/*",
    "https://amazon.com/*",
    "https://*.hotstar.com/*",
    "https://hotstar.com/*",
    "https://*.jiohotstar.com/*",
    "https://jiohotstar.com/*",
    "https://*.zee5.com/*",
    "https://zee5.com/*",
    "https://*.disneyplus.com/*",
    "https://disneyplus.com/*",
    "https://*.sonyliv.com/*",
    "https://sonyliv.com/*",
    "https://*.crunchyroll.com/*",
    "https://crunchyroll.com/*",
    "http://*/*",
    "https://*/*",
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.netflix.com/*",
        "https://netflix.com/*"
      ],
      "js": ["lib/socket.io.min.js", "adapters/netflix.js", "content.js"],
      "css": ["overlay/overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.primevideo.com/*",
        "https://primevideo.com/*",
        "https://*.amazon.com/gp/video/*",
        "https://*.amazon.com/*/video/*",
        "https://amazon.com/gp/video/*",
        "https://amazon.com/*/video/*"
      ],
      "js": ["lib/socket.io.min.js", "adapters/primevideo.js", "content.js"],
      "css": ["overlay/overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.hotstar.com/*",
        "https://hotstar.com/*",
        "https://*.jiohotstar.com/*",
        "https://jiohotstar.com/*"
      ],
      "js": ["lib/socket.io.min.js", "adapters/jiohotstar.js", "content.js"],
      "css": ["overlay/overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.zee5.com/*",
        "https://zee5.com/*"
      ],
      "js": ["lib/socket.io.min.js", "adapters/zee5.js", "content.js"],
      "css": ["overlay/overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.disneyplus.com/*",
        "https://disneyplus.com/*",
        "https://*.sonyliv.com/*",
        "https://sonyliv.com/*",
        "https://*.crunchyroll.com/*",
        "https://crunchyroll.com/*"
      ],
      "js": ["lib/socket.io.min.js", "adapters/generic.js", "content.js"],
      "css": ["overlay/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/socket.io.min.js",
        "overlay/overlay.css",
        "icons/*",
        "adapters/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
