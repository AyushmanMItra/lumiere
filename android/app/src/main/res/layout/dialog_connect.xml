<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/dialog_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/connect_dialog_title"
        android:textColor="@color/text_white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Enter host address or tap a local network preset below:"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/editServerUrl"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/input_background"
        android:hint="@string/server_url_hint"
        android:textColorHint="#6b7280"
        android:textColor="@color/text_white"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:inputType="textUri"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/btn_presets"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnPresetLocalhost"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/btn_preset_bg"
            android:text="Termux / Localhost (http://127.0.0.1:3000)"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:gravity="center_vertical|start"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <Button
            android:id="@+id/btnPresetHotspot"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/btn_preset_bg"
            android:text="Hotspot IP (http://192.168.43.1:3000)"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:gravity="center_vertical|start"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <Button
            android:id="@+id/btnPresetHttps"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/btn_preset_bg"
            android:text="Hotspot HTTPS (https://192.168.43.1:3443)"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:gravity="center_vertical|start"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:text="@string/btn_cancel"
            android:textColor="@color/text_muted"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_primary_bg"
            android:text="@string/btn_connect"
            android:textColor="@color/text_white"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />
    </LinearLayout>

</LinearLayout>
