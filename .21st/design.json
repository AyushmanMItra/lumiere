{
  "$schema": "https://21st.dev/schema/design.json",
  "name": "lumiere",
  "product": "private cinema watch party",
  "style": "dark-mode-oled",
  "tokens": {
    "colors": {
      "bg-canvas": "#07080a",
      "bg-app": "#0b0c10",
      "bg-card": "#12141c",
      "bg-surface": "#191b26",
      "bg-input": "#202330",
      "primary": "#6366f1",
      "primary-hover": "#4f46e5",
      "accent": "#ec4899",
      "coral": "#e50914",
      "green": "#22c55e",
      "text-primary": "#f8fafc",
      "text-muted": "#94a3b8",
      "border-subtle": "rgba(255, 255, 255, 0.08)",
      "border-focus": "rgba(99, 102, 241, 0.5)"
    },
    "typography": {
      "font-sans": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
